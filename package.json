{
  "name": "ig-helper",
  "version": "4.2.15",
  "packageManager": "bun@1.3.13",
  "description": "Simple and fast download of resources from Instagram (posts, reels, stories, and more).",
  "private": true,
  "author": "SN-Koarashi",
  "license": "GPLv3",
  "workspaces": [
    ".agents/skills/e2e"
  ],
  "scripts": {
    "dev": "vite",
    "build": "bun run --parallel build:*",
    "build:page": "vite build --mode page",
    "build:script": "vite build --mode script",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test tests/unit",
    "preview": "vite preview --outDir dist/page",
    "test:e2e": "bun tests/e2e/run.ts anonymous",
    "test:e2e:all": "bun tests/e2e/run.ts all",
    "test:e2e:ui": "bun tests/e2e/run.ts ui",
    "test:e2e:execution": "bun tests/e2e/run.ts execution",
    "test:e2e:exe": "bun tests/e2e/run.ts exe",
    "test:agent": "node .agents/skills/e2e/scripts/harness.ts browser --",
    "test:e2e:anonymous": "bun tests/e2e/run.ts anonymous",
    "test:e2e:auth": "bun tests/e2e/run.ts auth"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.1",
    "@types/jquery": "^4.0.0",
    "@types/tampermonkey": "^5.0.5",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "7.37.5",
    "globals": "^15.14.0",
    "tailwindcss": "4.3.1",
    "typescript": "^5.9",
    "typescript-eslint": "^8",
    "vite": "^8.2.2",
    "vite-userscript-plugin": "^2.5.0"
  },
  "dependencies": {
    "basecoat-css": "1.0.2",
    "effect": "4.0.0-rc.117",
    "jquery": "^4.0.0",
    "mediabunny": "1.34.5",
    "preact": "10.29.8",
    "wouter-preact": "^3.11.1",
    "zod": "^4.6.5"
  }
}
