{
  "name": "ig-helper",
  "version": "4.2.13",
  "packageManager": "bun@1.3.13",
  "description": "Simple and fast download of resources from Instagram (posts, reels, stories, and more).",
  "private": true,
  "author": "SN-Koarashi",
  "license": "GPLv3",
  "workspaces": [
    ".agents/skills/e2e"
  ],
  "scripts": {
    "dev": "vite",
    "build": "bun run --parallel build:*",
    "build:page": "vite build --mode page",
    "build:script": "vite build --mode script",
    "lint": "eslint .",
    "preview": "vite preview --outDir dist/page",
    "test:e2e": "node e2e/run-playwright.mjs",
    "test:agent": "node .agents/skills/e2e/scripts/harness.ts browser --"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.1",
    "@types/jquery": "^4.0.0",
    "@types/tampermonkey": "^5.0.5",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "7.37.5",
    "globals": "^15.14.0",
    "tailwindcss": "4.3.1",
    "vite": "^8.2.2",
    "vite-userscript-plugin": "^2.5.0"
  },
  "dependencies": {
    "basecoat-css": "1.0.2",
    "jquery": "^4.0.0",
    "mediabunny": "1.34.5",
    "preact": "10.29.8",
    "wouter-preact": "^3.11.1",
    "zod": "^4.6.5"
  }
}
