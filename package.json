{
  "name": "ig-helper",
  "version": "4.2.7",
  "packageManager": "bun@1.3.13",
  "description": "Simple and fast download of resources from Instagram (posts, reels, stories, and more).",
  "private": true,
  "author": "SN-Koarashi",
  "license": "GPLv3",
  "scripts": {
    "dev": "bun run --parallel dev:*",
    "dev:script": "vite",
    "dev:pages": "vite --config vite.pages.config.mjs",
    "build": "bun run --parallel build:*",
    "build:script": "vite build",
    "build:pages": "vite build --config vite.pages.config.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "bun test e2e/live.e2e.test.js --timeout 90000"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "4.3.1",
    "@types/jquery": "^4.0.0",
    "@types/tampermonkey": "^5.0.5",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "7.37.5",
    "globals": "^15.14.0",
    "tailwindcss": "4.3.1",
    "vite": "^8.2.2",
    "vite-plugin-monkey": "^8.1.1"
  },
  "dependencies": {
    "basecoat-css": "1.0.2",
    "jquery": "^4.0.0",
    "mediabunny": "1.34.5",
    "preact": "10.29.8",
    "wouter-preact": "^3.11.1"
  }
}
